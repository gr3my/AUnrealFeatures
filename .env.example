# Host/runtime
# Keep false for public/dev builds. Set true only if you explicitly want the process to request admin/root.
AUNREAL_AUTO_ELEVATE=false
# Use 127.0.0.1 when running behind a reverse proxy; use * to listen on all interfaces.
ASTRA_HTTP_BIND=127.0.0.1
# Enable only when requests arrive through a trusted reverse proxy that overwrites forwarding headers.
ASTRA_TRUST_PROXY_HEADERS=false
# Browser CORS policy; native game clients are unaffected.
ASTRA_CORS_ORIGIN=*

# Core database
AUNREAL_DATABASE_PASSWORD=CHANGE_ME_DATABASE_PASSWORD

# Ares / server registration
ARES_API_SIGNING_SECRET=CHANGE_ME_ARES_API_SIGNING_SECRET
ARES_SERVER_MASTER_KEY=CHANGE_ME_SERVER_MASTER_KEY
ARES_DEFAULT_BOARD_URL=https://example.invalid/your-board.png
GAME_BUILD_VERSION=1
GAME_BUILD_ID=1
GAME_DEPLOYMENT_ID_ARG=DashboardDeploymentId
GAME_AGENT_BIND=127.0.0.1
GAME_SOCKET_CONTROL_KEY=CHANGE_ME_GAME_SOCKET_CONTROL_KEY
GAME_STATION_ANNOUNCEMENT=Welcome to Your Game
GAME_DEFAULT_MAP=ExampleMap
# 0 disables expiry; set only if dedicated servers refresh /coordinator regularly.
VIRTEX_LIVE_SERVER_TTL_SECONDS=0
GAME_DEFAULT_STREAM_URL=https://example.invalid/stream
GAME_FALLBACK_STREAM_URL=
CONTENT_PORT=9094
CONTENT_ROOT=
CONTENT_PUBLIC_BASE_URL=http://localhost:9094
CONTENT_PLACEHOLDER_URL=http://localhost:9094/templates/placeholder.png

# EOS-compatible gateway
EOS_PRODUCT_ID=YOUR_EOS_PRODUCT_ID
EOS_SANDBOX_ID=YOUR_EOS_SANDBOX_ID
EOS_DEPLOYMENT_ID=YOUR_EOS_DEPLOYMENT_ID
EOS_ORGANIZATION_ID=YOUR_EOS_ORGANIZATION_ID
EOS_CLIENT_ID=YOUR_EOS_CLIENT_ID
EOS_TOKEN_ISSUER=https://example.invalid/eos/auth/v1/oauth
EOS_PUBLIC_HOST=127.0.0.1
EOS_PUBLIC_HTTP_BASE=http://127.0.0.1:50
EOS_PUBLIC_WS_BASE=ws://127.0.0.1:80

# TURN / RTC
TURN_HOST=127.0.0.1
TURN_PORT=3478
TURN_SHARED_SECRET=CHANGE_ME_TURN_SHARED_SECRET
RTC_WS_URL=ws://127.0.0.1:7880
RTC_API_KEY=CHANGE_ME_RTC_API_KEY
RTC_API_SECRET=CHANGE_ME_RTC_API_SECRET

# PlayFab-compatible service
PLAYFAB_TITLE_ID=YOUR_TITLE_ID
PLAYFAB_DEV_SECRET=CHANGE_ME_PLAYFAB_DEV_SECRET
PLAYFAB_ENTITY_SECRET=CHANGE_ME_PLAYFAB_ENTITY_SECRET
PLAYFAB_CONTAINER_REGISTRY_PASSWORD=
# Optional: item-id|Display Name;item-id-2|Display Name 2
PLAYFAB_DEFAULT_ACCESS_ITEMS=

# Photon integration (optional)
PHOTON_REALTIME_APP_ID=YOUR_PHOTON_REALTIME_APP_ID
PHOTON_REALTIME_SECRET=CHANGE_ME_PHOTON_REALTIME_SECRET
PHOTON_CHAT_APP_ID=YOUR_PHOTON_CHAT_APP_ID
PHOTON_CHAT_SECRET=CHANGE_ME_PHOTON_CHAT_SECRET
PHOTON_VOICE_APP_ID=YOUR_PHOTON_VOICE_APP_ID
PHOTON_VOICE_SECRET=CHANGE_ME_PHOTON_VOICE_SECRET

# External identity providers (optional)
STEAM_AUTH_ENFORCE=false
STEAM_WEB_API_KEY=CHANGE_ME_STEAM_WEB_API_KEY
STEAM_APP_ID=YOUR_STEAM_APP_ID
STEAM_AUTH_URL=https://example.invalid/steam-auth-endpoint

# Meta platform verification (optional)
META_QUEST_APP_ID=YOUR_META_QUEST_APP_ID
META_QUEST_APP_SECRET=CHANGE_ME_META_QUEST_APP_SECRET
META_RIFT_APP_ID=YOUR_META_RIFT_APP_ID
META_RIFT_APP_SECRET=CHANGE_ME_META_RIFT_APP_SECRET
META_QUEST_PACKAGE_ID=YOUR_PACKAGE_ID
META_QUEST_CERT_SHA256=YOUR_CERT_SHA256
META_NONCE_VERIFY=false
META_NONCE_ENFORCE=false
META_NONCE_FAIL_OPEN=false
META_ORGANIZATION_ID=
META_PLATFORM_INTEGRITY_VERIFY_URL=https://example.invalid/meta/platform-integrity/verify
META_USER_NONCE_URL=https://example.invalid/meta/user-nonce-validate
META_DEVICE_BAN_URL=https://example.invalid/meta/platform-integrity/device-ban
META_SSO_URL=https://example.invalid/meta/sso

# Mothership
MOTHERSHIP_JWT_SECRET=CHANGE_ME_MOTHERSHIP_JWT_SECRET
MOTHERSHIP_ENVIRONMENT_ID=YOUR_ENVIRONMENT_ID
MOTHERSHIP_TENANT_ID=YOUR_TITLE_ID
MOTHERSHIP_SERVER_API_KEY=CHANGE_ME_SERVER_API_KEY
MOTHERSHIP_AUTOMATION_KEY=CHANGE_ME_AUTOMATION_KEY

# Dashboard
DASHBOARD_ORIGIN=http://localhost:3000
DASHBOARD_AUTH_ENFORCE=false
DASHBOARD_SESSION_SECRET=CHANGE_ME_DASHBOARD_SESSION_SECRET
DASHBOARD_ADMIN_KEY=CHANGE_ME_DASHBOARD_ADMIN_KEY
ARES_DASHBOARD_BACKEND_URL=http://127.0.0.1:8080
ARES_GAME_BACKEND_URL=http://127.0.0.1:78
